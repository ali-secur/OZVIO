PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BotAdi

TMP_DIR=/tmp/downloads
DB_FILE=./data.sqlite
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Varsayılan olarak YouTube, Instagram, TikTok, X, Facebook, Reddit, Twitch, Vimeo vb. açıktır.
# Buraya yazdığın alan adları bunlara EKLENİR (virgülle): örn. ALLOWED_HOSTS=ornek.com,baska.com
#ALLOWED_HOSTS=

# Eşzamanlı "geçici dosya" indirme sayısı (Instagram/TikTok/X ve 1080p+ YouTube bunu kullanır)
MAX_CONCURRENT_MUX=4

# Günlük indirme kotası: 0 = sınırsız
DAILY_DOWNLOAD_LIMIT=20
UNVERIFIED_DAILY_DOWNLOAD_LIMIT=3

# Video çözünürlük sınırı: 0 = sınırsız
MAX_VIDEO_HEIGHT=2160
UNVERIFIED_MAX_VIDEO_HEIGHT=720

# Video süresi saniye cinsinden: 0 = sınırsız
MAX_DURATION_SECONDS=10800

# Dosya boyutu: 0 = sınırsız
MAX_FILE_SIZE=4G

# Giriş isteyen Instagram/TikTok/X içerikleri için (isteğe bağlı): Netscape formatında cookies.txt yolu
#COOKIES_FILE=/opt/video-dl/cookies.txt

# 1 yazarsan oturum yalnızca Telegram'da onaylanan IP'den geçerli olur (mobil ağlarda IP değişebilir, varsayılan kapalı)
#BIND_SESSION_IP=0
